class Program:

    private static void Test():
        for i = 0 to 10:
            if i == 5:
                break
            print "${i}"

    private static int Factorial(int n):
        if n <= 1:
            return 1
        return n * Factorial(n - 1)

    private static int Add(int o):
        o += 5
        return o

